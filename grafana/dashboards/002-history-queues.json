{
  "title": "002 — History Queues",
  "uid": "002-history-queues",
  "tags": [
    "scenario",
    "history-queues"
  ],
  "schemaVersion": 42,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "allowCustomValue": true,
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "allowCustomValue": true,
        "current": {
          "text": "0.99",
          "value": "0.99"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Percentile",
        "multi": false,
        "name": "percentile",
        "options": [
          {
            "selected": false,
            "text": "0.50",
            "value": "0.50"
          },
          {
            "selected": false,
            "text": "0.90",
            "value": "0.90"
          },
          {
            "selected": false,
            "text": "0.95",
            "value": "0.95"
          },
          {
            "selected": true,
            "text": "0.99",
            "value": "0.99"
          }
        ],
        "query": "0.50,0.90,0.95,0.99",
        "skipUrlSync": false,
        "type": "custom",
        "valuesFormat": "csv"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Which queue is behind? — read queue latency, then schedule latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue latency $percentile by queue (task_latency_queue)",
      "description": "Task creation → completion. High for one queue = that queue is behind. Baseline: transfer/timer ~0.03s, visibility ~1s (Elasticsearch).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($percentile, sum by (le, queue)(label_replace(rate(task_latency_queue_bucket{namespace=\"default\"}[$__rate_interval]), \"queue\", \"$1\", \"task_type\", \"(Transfer|Timer|Visibility).*\")))",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Schedule latency $percentile by queue (task_latency_schedule)",
      "description": "How long a loaded task waits for a scheduler worker. High = worker pool saturated. Low while queue latency is high = tasks aren't being loaded (reader throttled or slow DB).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($percentile, sum by (le, queue)(label_replace(rate(task_latency_schedule_bucket{namespace=\"default\"}[$__rate_interval]), \"queue\", \"$1\", \"task_type\", \"(Transfer|Timer|Visibility).*\")))",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tasks executed per second by queue",
      "description": "Throughput of each queue. Baseline at rps=60: transfer ~180, timer ~240, visibility ~180.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum by (queue)(label_replace(rate(task_requests{namespace=\"default\"}[$__rate_interval]), \"queue\", \"$1\", \"task_type\", \"(Transfer|Timer|Visibility).*\"))",
          "legendFormat": "{{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Task errors and retries by queue",
      "description": "Failed task attempts. Starving a reader delays tasks but should not make them fail.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum by (queue)(label_replace(rate(task_errors{namespace=\"default\"}[$__rate_interval]), \"queue\", \"$1\", \"task_type\", \"(Transfer|Timer|Visibility).*\"))",
          "legendFormat": "errors · {{queue}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Client impact (SDK)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Workflows completed per second",
      "description": "End-to-end throughput seen by the load generator. Baseline ~60/s.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "sum(rate(temporal_workflow_completed[$__rate_interval]))",
          "legendFormat": "completed/s",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Workflow task schedule-to-start $percentile",
      "description": "Rises when the TRANSFER queue is behind (the task never reached Matching). Stays low when only the timer queue is behind. Histogram tops out at 10s.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($percentile, sum by (le)(rate(temporal_workflow_task_schedule_to_start_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "WFT schedule-to-start",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Workflow end-to-end latency $percentile",
      "description": "Baseline ~4s with 2s timers. Rises when timers fire late. Histogram tops out at 10s, so anything slower reads as 10.",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($percentile, sum by (le)(rate(temporal_workflow_endtoend_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "end-to-end",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Detail — every task type",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queue latency $percentile by task type",
      "description": "Same as the top-left panel, split by task type (e.g. TransferActiveTaskWorkflowTask, TimerActiveTaskUserTimer, VisibilityTaskCloseExecution).",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "histogram_quantile($percentile, sum by (le, task_type)(rate(task_latency_queue_bucket{namespace=\"default\"}[$__rate_interval])))",
          "legendFormat": "{{task_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "annotations": {
